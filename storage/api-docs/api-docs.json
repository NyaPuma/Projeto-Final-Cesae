{
    "openapi": "3.0.0",
    "info": {
        "title": "Gestão de Avarias API",
        "description": "Documentação OpenAPI da aplicação de gestão de tickets, equipamentos, auditoria e relatórios.",
        "contact": {
            "name": "Departamento de Manutenção e TI",
            "email": "suporte@manutencao.local"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Servidor Principal da API"
        }
    ],
    "paths": {
        "/admin/audits": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Listar auditoria",
                "description": "Lista os registos de auditoria do sistema.\nProtegido globalmente via middleware e verificado via Policy.",
                "operationId": "395c570d8f9419ab32f3da4f449e7613",
                "responses": {
                    "200": {
                        "description": "Lista paginada de registos de auditoria"
                    }
                },
                "security": [
                    {
                        "X-Auth-Token": []
                    },
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/notifications": {
            "get": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Listar notificações do utilizador",
                "description": "Lista de forma paginada as notificações do utilizador autenticado.",
                "operationId": "0f031f66cd8c52bf73e89fb2d050ad83",
                "responses": {
                    "200": {
                        "description": "Lista paginada de notificações"
                    }
                },
                "security": [
                    {
                        "X-Auth-Token": []
                    },
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/notifications/{id}": {
            "patch": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Marcar notificação como lida",
                "description": "Marca uma notificação específica como lida.",
                "operationId": "58fb6750c2d309a0bc5028c22b02f9f8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Notificação atualizada"
                    },
                    "404": {
                        "description": "Notificação não encontrada"
                    }
                },
                "security": [
                    {
                        "X-Auth-Token": []
                    },
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/notifications/test-email": {
            "post": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Enviar email de teste via Mailgun",
                "description": "Dispara o envio de um email de teste em background via fila.",
                "operationId": "c9f9ddcef1df2e8861c2e75c356531d1",
                "responses": {
                    "200": {
                        "description": "Email de teste enviado"
                    }
                },
                "security": [
                    {
                        "X-Auth-Token": []
                    },
                    {
                        "BearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "X-Auth-Token": {
                "type": "apiKey",
                "description": "Token de autenticação personalizado baseado em cabeçalho",
                "name": "X-Auth-Token",
                "in": "header"
            },
            "BearerAuth": {
                "type": "http",
                "description": "Autenticação baseada em Token JWT",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Admin",
            "description": "Admin"
        },
        {
            "name": "Notifications",
            "description": "Notifications"
        }
    ]
}