{
    auto_https off

    admin off

    log {
        output stdout
        format console
    }
}

:80 {

    root * /app/public

    encode gzip zstd

    php_server

    file_server

    # Long-lived cache for hashed build assets
    @assets path /build/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header @assets ETag ""

    # Do not cache HTML/application responses
    @no-cache path /*.php /api/*
    header @no-cache Cache-Control "no-store"

    # Basic security headers
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

}
