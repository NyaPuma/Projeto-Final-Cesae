APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt-PT
APP_FALLBACK_LOCALE=pt-PT
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_CONNECTION=default
# SESSION_STORE=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis
# Time (s) until a blocked job is made available again.
# Must be greater than the timeout of the longest jobs (PDF exports = 180s).
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Laravel Octane (production server). Defaults target the FrankenPHP Docker deployment.
# OCTANE_SERVER=frankenphp
# OCTANE_HTTPS=false
# OCTANE_MAX_EXECUTION_TIME=30
# OCTANE_STATE_FILE=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_CACHE_CONNECTION=default
# REDIS_QUEUE_CONNECTION=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Application-specific settings
# ---------------------------------------------------------------------------

# Authentication / sessions
# API token length in characters (min 32) and its validity in days.
API_TOKEN_LENGTH=60
AUTH_TOKEN_EXPIRY_DAYS=30
# Rate-limit and lockout policy for login failures.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Hours a password reset token remains valid.
AUTH_PASSWORD_TIMEOUT=60

# AI recommendation engine (OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
AI_MODEL=
AI_TEMPERATURE=0.2
OPENAI_REQUEST_TIMEOUT=30

# Notifications / email
NOTIFICATION_MAILER=log
# Mailers for transactional email (sendgrid / mailgun / postmark / resend / smtp)
SENDGRID_API_KEY=
SENDGRID_HOST=
SENDGRID_USERNAME=
SENDGRID_PASSWORD=
SENDGRID_PORT=587
SENDGRID_SCHEME=smtp
SENDGRID_EHLO_DOMAIN=
SENDGRID_URL=smtp.sendgrid.net
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_SCHEME=https
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Business rules
# Ticket budget threshold (EUR) above which manager approval is required.
BUDGET_THRESHOLD=1500
# SLA target in minutes for ticket resolution.
SLA_TARGET_MINUTES=7200
# System availability flag (enables/disables maintenance mode of the API).
SYSTEM_AVAILABILITY=true

# Pagination defaults
PAGINATION_PER_PAGE=20
ADMIN_PAGINATION_PER_PAGE=50

# Ticket photo uploads (validation bounds)
UPLOAD_ALLOWED_PHOTO_MIMES=jpeg,jpg,png,gif,webp
UPLOAD_MAX_PHOTO_SIZE_KB=2048
UPLOAD_MAX_PHOTO_WIDTH=4096
UPLOAD_MAX_PHOTO_HEIGHT=4096

# Database backups (maintenance command defaults)
DB_BACKUP_CONNECTION=
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_COMPRESSION=true

# OpenAPI / Swagger
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_UI_DARK_MODE=false

VITE_APP_NAME="${APP_NAME}"
